{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SafeVault": {
    // Folder holding users.json and the audit log. Keep it OUTSIDE the web root.
    "DataDirectory": "App_Data",
    "Security": {
      "MaxFailedLoginAttempts": 5,
      "LockoutMinutes": 15,
      "Pbkdf2Iterations": 600000,
      "AuthRequestsPerMinute": 10
    },
    "SeedAdmin": {
      "Username": "admin",
      "Email": "admin@safevault.local",
      // Leave empty to generate a random password that is printed to the console ONCE.
      // Prefer user-secrets or an environment variable (SafeVault__SeedAdmin__Password) over editing this file.
      "Password": ""
    }
  }
}
