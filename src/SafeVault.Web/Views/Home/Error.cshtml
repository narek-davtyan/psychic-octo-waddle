@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<h1>Something went wrong</h1>
<p>The request could not be completed. Nothing sensitive is shown here on purpose.</p>
@if (Model.ShowRequestId)
{
    <p class="muted">Reference: <code>@Model.RequestId</code></p>
}
<p><a asp-controller="Home" asp-action="Index">Back to the home page</a></p>
